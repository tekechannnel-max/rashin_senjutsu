NODE_ENV=development
HOST=127.0.0.1
PORT=3000

ANTHROPIC_API_KEY=replace-with-anthropic-api-key
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_FREE_MODEL=gpt-5.4-mini
ANTHROPIC_PAID_MODEL=claude-sonnet-4-6
ANTHROPIC_HISTORY_MODEL=claude-sonnet-4-6
OPENAI_LIGHT_MODEL=gpt-5.4-mini
OPENAI_PAID_FALLBACK_MODEL=gpt-5.4
OPENAI_STRUCTURE_MODEL=gpt-5.4-mini

GOOGLE_CLIENT_ID=replace-with-google-client-id

STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
STRIPE_PRICE_ID_MONTHLY=price_xxxxxxxxxxxxx
STRIPE_PRICE_ID_DEEP_READING_580=price_xxxxxxxxxxxxx
STRIPE_SUCCESS_PATH=/uranai-v5.html?stripe_success=1&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_PATH=/uranai-v5.html?stripe_cancel=1
STRIPE_PORTAL_RETURN_PATH=/uranai-v5.html
STRIPE_SUBSCRIPTION_NAME=深掘り鑑定
STRIPE_TRIAL_PERIOD_DAYS=7

MEMBER_ACCESS_CODE=replace-with-member-access-code
# 本番では必須です。32 bytes以上のランダムな値を設定してください。
MEMBER_SESSION_SECRET=replace-with-long-random-secret
MEMBER_SESSION_DAYS=30
AUTH_SESSION_SECRET=replace-with-long-random-secret
AUTH_SESSION_DAYS=30
DEVELOPER_ACCESS_EMAILS=example@example.com
