NODE_ENV=development
ENABLE_DEV_ACCESS=false
PUBLIC_ORIGIN=http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
TRUST_PROXY=false
HOST=127.0.0.1
PORT=3000

ANTHROPIC_API_KEY=replace-with-anthropic-api-key
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_FREE_MODEL=gpt-5.4-mini
ANTHROPIC_PAID_MODEL=claude-sonnet-4-6
ANTHROPIC_HISTORY_MODEL=claude-sonnet-4-6
OPENAI_LIGHT_MODEL=gpt-5.4-mini
OPENAI_PAID_FALLBACK_MODEL=gpt-5.4
OPENAI_PAID_AB_MODEL=gpt-5.5
OPENAI_STRUCTURE_MODEL=gpt-5.4-mini
PAID_MODEL_AB_TEST_ENABLED=false
PAID_MODEL_AB_TEST_OPENAI_WEIGHT=50

GOOGLE_CLIENT_ID=replace-with-google-client-id

RASHIN_CODE_ADMIN_SECRET=replace-with-long-random-admin-secret
RASHIN_FREE_PAID_CODES=replace-with-12-character-code
DEEP_READING_ONCE_AMOUNT=780
DEEP_READING_PRERELEASE_AMOUNT=780
DEEP_READING_RELEASE_AMOUNT=1000
PAYPAY_MANUAL_PAYMENT_URL=https://qr.paypay.ne.jp/replace-with-your-paypay-qr-url
PAYPAY_MANUAL_PAYMENT_LABEL=Rashin Senjutsu PayPay
PAYPAY_MANUAL_PAYMENT_NOTE=PayPay payment opens in a separate app. Enter the PayPay transaction number after payment.
PAYPAY_MANUAL_AUTO_ISSUE_ENABLED=false
MEMBER_ACCESS_CODE=replace-with-member-access-code
RASHIN_ACCESS_CODES=replace-with-7-digit-code
RASHIN_CODE_SESSION_DAYS=30
RASHIN_CODE_REUSE_DAYS=30

# Optional SNS automation
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
THREADS_PUBLISH_WAIT_MS=30000
THREADS_EXPECTED_USERNAME=sensai_teke
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://rashin-senjutsu.onrender.com/auth/threads/callback
THREADS_SCOPES=threads_basic,threads_content_publish
SOCIAL_AUTOMATED_POSTING_ENABLED=false
SOCIAL_PLATFORMS=threads
SOCIAL_ORACLE_TIME=07:00
SOCIAL_CONCEPT_TIME=20:00
# 本番では必須です。32 bytes以上のランダムな値を設定してください。
MEMBER_SESSION_SECRET=replace-with-long-random-secret
MEMBER_SESSION_DAYS=30
AUTH_SESSION_SECRET=replace-with-long-random-secret
AUTH_SESSION_DAYS=30
DEVELOPER_ACCESS_EMAILS=example@example.com
