NODE_ENV=development
ENABLE_DEV_ACCESS=false
PUBLIC_ORIGIN=http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
TRUST_PROXY=false
HOST=127.0.0.1
PORT=3000

ANTHROPIC_API_KEY=replace-with-anthropic-api-key
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_FREE_MODEL=gpt-5.4-mini
ANTHROPIC_PAID_MODEL=claude-sonnet-4-6
ANTHROPIC_HISTORY_MODEL=claude-sonnet-4-6
OPENAI_LIGHT_MODEL=gpt-5.4-mini
OPENAI_PAID_FALLBACK_MODEL=gpt-5.4
OPENAI_PAID_AB_MODEL=gpt-5.5
OPENAI_STRUCTURE_MODEL=gpt-5.4-mini
PAID_MODEL_AB_TEST_ENABLED=false
PAID_MODEL_AB_TEST_OPENAI_WEIGHT=50

GOOGLE_CLIENT_ID=replace-with-google-client-id

RASHIN_CODE_ADMIN_SECRET=replace-with-long-random-admin-secret
RASHIN_FREE_PAID_CODE_HASH_FILE=config/rashin-free-paid-code-hashes.json
RASHIN_FREE_PAID_CODES=
RASHIN_REUSABLE_PAID_CODE_HASH_FILE=config/rashin-reusable-paid-code-hashes.json
RASHIN_REUSABLE_PAID_CODES=
DEEP_READING_ONCE_AMOUNT=780
DEEP_READING_PRERELEASE_AMOUNT=780
DEEP_READING_RELEASE_AMOUNT=1000
BOOTH_DEEP_READING_URL=https://teke-sensai.booth.pm/
BOOTH_PAYMENT_LABEL=羅針占術 BOOTH
BOOTH_PAYMENT_NOTE=BOOTH内のどのグッズを購入しても、購入後のBOOTH注文番号で深掘り羅針鑑定を利用できます。
BOOTH_GMAIL_VERIFICATION_REQUIRED=true
BOOTH_GMAIL_IMAP_USER=replace-with-gmail-address
BOOTH_GMAIL_IMAP_APP_PASSWORD=replace-with-gmail-app-password
BOOTH_GMAIL_IMAP_HOST=imap.gmail.com
BOOTH_GMAIL_IMAP_PORT=993
BOOTH_GMAIL_IMAP_MAILBOX=INBOX
BOOTH_GMAIL_SEARCH_FROM=booth.pm
BOOTH_GMAIL_SEARCH_DAYS=90
BOOTH_GMAIL_VERIFY_TIMEOUT_MS=12000
BOOTH_GMAIL_MATCH_BUYER_EMAIL=false
MEMBER_ACCESS_CODE=replace-with-member-access-code
RASHIN_ACCESS_CODES=replace-with-7-digit-code
RASHIN_CODE_SESSION_DAYS=30
RASHIN_CODE_REUSE_DAYS=30

# Optional SNS automation
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
THREADS_PUBLISH_WAIT_MS=30000
THREADS_EXPECTED_USERNAME=sensai_teke
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://rashin-senjutsu.onrender.com/auth/threads/callback
THREADS_SCOPES=threads_basic,threads_content_publish
BLUESKY_IDENTIFIER=tekesensai.bsky.social
BLUESKY_APP_PASSWORD=
BLUESKY_EXPECTED_HANDLE=tekesensai.bsky.social
SOCIAL_AUTOMATED_POSTING_ENABLED=false
SOCIAL_PLATFORMS=threads,bluesky
SOCIAL_ORACLE_TIME=07:00
SOCIAL_CONCEPT_TIME=20:00
SOCIAL_POST_GRACE_MINUTES=2
SOCIAL_API_RETRY_ATTEMPTS=3
SOCIAL_API_RETRY_BASE_MS=1500
SOCIAL_POSTS_LEDGER_FILE=data/social-posts/posts.csv
SOCIAL_UTM_CAMPAIGN=202605_prerelease
SOCIAL_PAID_CTA_MODE=soft
SOCIAL_RELEASE_MODE=prelaunch
SOCIAL_BOOTH_ENABLED=false
# 本番では必須です。32 bytes以上のランダムな値を設定してください。
MEMBER_SESSION_SECRET=replace-with-long-random-secret
MEMBER_SESSION_DAYS=30
AUTH_SESSION_SECRET=replace-with-long-random-secret
AUTH_SESSION_DAYS=30
DEVELOPER_ACCESS_EMAILS=example@example.com
