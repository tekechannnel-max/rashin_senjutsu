{
  "name": "rashin-senjutsu",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "check": "node --check server.js && node --check app.js && node --check scripts/social/daily-oracle-post.js && node --check scripts/social/run-scheduled-posts.js && node --check scripts/social/threads-client.js && node --check scripts/social/threads-tool.js && node --check scripts/social/audit-social-drafts.js && node --check scripts/social/export-x-drafts.js",
    "social:audit": "node scripts/social/audit-social-drafts.js",
    "social:draft": "node scripts/social/daily-oracle-post.js --dry-run",
    "social:write": "node scripts/social/daily-oracle-post.js --write",
    "social:post": "node scripts/social/daily-oracle-post.js --write --post",
    "social:threads:draft": "node scripts/social/daily-oracle-post.js --dry-run --platforms=threads",
    "social:threads:post": "node scripts/social/daily-oracle-post.js --write --post --platforms=threads",
    "social:x:drafts": "node scripts/social/export-x-drafts.js",
    "social:x:today": "node scripts/social/export-x-drafts.js --date=today",
    "social:run-due": "node scripts/social/run-scheduled-posts.js --once",
    "social:daemon": "node scripts/social/run-scheduled-posts.js --daemon",
    "threads:doctor": "node scripts/social/threads-tool.js doctor",
    "threads:auth-url": "node scripts/social/threads-tool.js auth-url",
    "threads:connect": "node scripts/social/threads-tool.js connect",
    "threads:save-token": "node scripts/social/threads-tool.js save-token",
    "threads:refresh": "node scripts/social/threads-tool.js refresh"
  },
  "engines": {
    "node": ">=20"
  }
}
